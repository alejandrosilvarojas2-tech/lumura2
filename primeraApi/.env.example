# Copia este archivo como ".env" (en esta misma carpeta) y define los valores reales.
# El archivo .env NO se sube al repositorio (ya está excluido en .gitignore).
# Docker Compose lo lee automáticamente; para ejecutar sin Docker define las
# mismas variables como variables de entorno del sistema.

DB_USER=lumura
DB_PASSWORD=cambia_esta_clave
MYSQL_ROOT_PASSWORD=cambia_esta_clave_root
JWT_SECRET=genera_un_secreto_aleatorio_de_al_menos_32_caracteres
